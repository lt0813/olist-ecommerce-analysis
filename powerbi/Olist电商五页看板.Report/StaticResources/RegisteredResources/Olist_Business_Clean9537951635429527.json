{
  "name": "Olist Business Clean",
  "dataColors": [
    "#0F766E",
    "#EA580C",
    "#2563EB",
    "#7C3AED",
    "#DC2626",
    "#D97706",
    "#0891B2",
    "#15803D"
  ],
  "foreground": "#1F2937",
  "foregroundNeutralSecondary": "#64748B",
  "background": "#FFFFFF",
  "backgroundLight": "#F3F5F7",
  "backgroundNeutral": "#E5E7EB",
  "tableAccent": "#0F766E",
  "good": "#15803D",
  "neutral": "#D97706",
  "bad": "#DC2626",
  "maximum": "#0F766E",
  "center": "#D97706",
  "minimum": "#C2410C",
  "null": "#9CA3AF",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 24,
      "color": "#1F2937"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 18,
      "color": "#1F2937"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 14,
      "color": "#4B5563"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 44,
      "color": "#1F2937"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D6DCE4"
              }
            },
            "radius": 6
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1F2937"
              }
            },
            "fontSize": 20,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F5F7"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F3F5F7"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1F2937"
              }
            },
            "fontSize": 44,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 14
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 14
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 12
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 12
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "legend": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#4B5563"
              }
            },
            "fontSize": 13
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 12
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            },
            "rowPadding": 4
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F2937"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F3F5F7"
              }
            },
            "fontSize": 14
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#374151"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 13
          }
        ]
      }
    }
  }
}