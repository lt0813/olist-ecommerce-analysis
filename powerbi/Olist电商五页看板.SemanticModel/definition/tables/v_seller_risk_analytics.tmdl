table v_seller_risk_analytics
	lineageTag: 07a68f72-8b51-4d21-baae-9547a3686037

	measure 风险卖家数 = CALCULATE(COUNTROWS('v_seller_risk_analytics'), 'v_seller_risk_analytics'[是否风险卖家] = 1)
		formatString: #,0
		lineageTag: 558277a4-8f83-48b0-bf9d-30380f5b6204

	measure 风险卖家GMV = CALCULATE(SUM('v_seller_risk_analytics'[卖家GMV]), 'v_seller_risk_analytics'[是否风险卖家] = 1)
		formatString: #,0.00
		lineageTag: 56c705f5-4c96-4024-9cc4-f333d6a76c8b

	measure 风险卖家GMV占比 = DIVIDE([风险卖家GMV], SUM('v_seller_risk_analytics'[卖家GMV]))
		formatString: 0.00%
		lineageTag: 30a1c3a0-869a-4d8c-abf1-07cd748ef018

	measure 风险卖家平均延迟率 = CALCULATE(AVERAGE('v_seller_risk_analytics'[卖家延迟率]), 'v_seller_risk_analytics'[是否风险卖家] = 1)
		formatString: 0.00%
		lineageTag: 1b8fe9af-1223-4529-b941-448e308652c6

	measure 风险卖家平均差评率 = CALCULATE(AVERAGE('v_seller_risk_analytics'[卖家差评率]), 'v_seller_risk_analytics'[是否风险卖家] = 1)
		formatString: 0.00%
		lineageTag: 1105a1f4-9ddc-47e4-86c7-3a25dd57b8da

	measure 卖家GMV总额 = SUM('v_seller_risk_analytics'[卖家GMV])
		formatString: #,0.00

