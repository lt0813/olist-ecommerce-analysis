table v_category_analytics
	lineageTag: d99fed1d-d13c-48da-8b4d-7f7d26eecc16

	measure 类目GMV总额 = SUM('v_category_analytics'[类目GMV])
		formatString: #,0.00

	measure 类目成交订单总量 = SUM('v_category_analytics'[类目成交订单数])
		formatString: #,0

	measure 类目商品行总量 = SUM('v_category_analytics'[商品行数])
		formatString: #,0

	measure 类目商品金额总额 = SUM('v_category_analytics'[类目商品金额])
		formatString: #,0.00

	measure 类目运费总额 = SUM('v_category_analytics'[类目运费金额])
		formatString: #,0.00

