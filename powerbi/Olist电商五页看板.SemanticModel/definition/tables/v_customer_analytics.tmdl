table v_customer_analytics
	lineageTag: f98a7b51-f26a-44b2-a76c-ebb20645bf12

	measure 成交客户数 = COUNTROWS('v_customer_analytics')
		formatString: #,0
		lineageTag: b00b15e7-4e54-43b0-b3eb-c3dca5617436

	measure 复购客户数 = SUM('v_customer_analytics'[是否复购客户])
		formatString: #,0
		lineageTag: 0bc14145-f06e-4d0b-acf5-6a66a8e8122c

	measure 复购客户率 = DIVIDE([复购客户数], [成交客户数])
		formatString: 0.00%
		lineageTag: a21461ee-d75d-4959-88fd-a42e5a20403b

	measure 客户平均消费 = AVERAGE('v_customer_analytics'[客户累计消费])
		formatString: #,0.00
		lineageTag: 3c8d242c-a2f6-46b1-8272-51386a638a72

	measure 客户累计消费总额 = SUM('v_customer_analytics'[客户累计消费])
		formatString: #,0.00

	measure 客户最早首购时间 = MIN('v_customer_analytics'[首购时间])
		formatString: General Date

	measure 客户最近购买时间 = MAX('v_customer_analytics'[最近购买时间])
		formatString: General Date

