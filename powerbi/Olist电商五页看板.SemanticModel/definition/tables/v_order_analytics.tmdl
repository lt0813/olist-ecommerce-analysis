table v_order_analytics
	lineageTag: 3a28c8fc-aa7a-412f-9719-77bb83e66e40

	measure GMV = CALCULATE(SUM('v_order_analytics'[recognized_gmv]), 'v_order_analytics'[is_delivered] = 1)
		formatString: #,0.00
		lineageTag: bbf40e7c-25b0-4dc9-837c-847ada23527e

	measure 成交订单量 = CALCULATE(DISTINCTCOUNT('v_order_analytics'[order_id]), 'v_order_analytics'[is_delivered] = 1)
		formatString: #,0
		lineageTag: a284c587-2c90-4142-9b7e-a6c3ba793e1b

	measure 客单价 = DIVIDE([GMV], [成交订单量])
		formatString: #,0.00
		lineageTag: 5ab66df7-b04b-4665-86cf-6c0c513c59f3

	measure 延迟率 = DIVIDE(CALCULATE(SUM('v_order_analytics'[是否延迟]), 'v_order_analytics'[is_delivered] = 1), CALCULATE(SUM('v_order_analytics'[has_delivery_dates]), 'v_order_analytics'[is_delivered] = 1))
		formatString: 0.00%
		lineageTag: 0dc643fb-39a8-4e8e-9de6-e0d36cde9084

	measure 差评率 = DIVIDE(CALCULATE(SUM('v_order_analytics'[是否差评]), 'v_order_analytics'[is_delivered] = 1), CALCULATE(COUNTROWS('v_order_analytics'), 'v_order_analytics'[is_delivered] = 1, 'v_order_analytics'[review_count] > 0))
		formatString: 0.00%
		lineageTag: e7002537-e4fb-4bf3-9fa5-b5b3bcf67c9b

	measure 平均履约天数 = CALCULATE(AVERAGE('v_order_analytics'[总履约天数]), 'v_order_analytics'[is_delivered] = 1)
		formatString: #,0.00
		lineageTag: df252b2e-a4d1-4883-a095-dcdead8fb076

